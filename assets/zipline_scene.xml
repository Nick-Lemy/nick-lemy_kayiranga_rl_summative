<!--
  Zipline-style blood-delivery quadrotor over Rwandan hill terrain.

  The scene is deliberately physical rather than abstract:

    * the terrain is a 96x96 heightfield whose elevation buffer is regenerated
      procedurally on every reset, so the agent never sees the same hills twice
      (domain randomisation -> supports the generalisation test in the report),

    * the UAV is a genuine 4-rotor airframe. The agent's discrete actions move
      attitude/thrust setpoints which an onboard PD loop mixes into four rotor
      thrusts, so translation, banking, stalling and crashing all emerge from
      rigid-body dynamics rather than from scripted kinematics,

    * the blood payload is a separate free body welded to the airframe. The
      RELEASE_PAYLOAD action deactivates that weld, so the box really detaches
      with the UAV's momentum and really falls onto the health post.

  Distances are compressed relative to a real Zipline sortie (~50 km) so that a
  delivery fits in a ~20 s episode, but the flight envelope, thrust-to-weight
  ratio and payload fraction are kept in a realistic range.
-->
<mujoco model="zipline_blood_delivery">

  <compiler angle="radian" autolimits="true"/>

  <!-- density/viscosity are non-zero so MuJoCo itself supplies aerodynamic drag -->
  <option timestep="0.01" gravity="0 0 -9.81" density="1.225" viscosity="1.8e-5"
          integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.65 0.65 0.65" specular="0.15 0.15 0.15"/>
    <rgba haze="0.74 0.83 0.90 1"/>
    <global azimuth="140" elevation="-20" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096" offsamples="8"/>
    <map znear="0.05" zfar="80" haze="0.25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.33 0.56 0.78" rgb2="0.84 0.91 0.97"
             width="512" height="512"/>

    <texture name="grass" type="2d" builtin="checker" mark="edge"
             rgb1="0.20 0.38 0.16" rgb2="0.34 0.56 0.26" markrgb="0.16 0.30 0.13"
             width="512" height="512"/>
    <material name="terrain_mat" texture="grass" texrepeat="14 14" texuniform="true"
              specular="0.04" shininess="0.04" reflectance="0.0"/>

    <!-- elevation buffer is overwritten from python on every reset -->
    <hfield name="terrain" nrow="96" ncol="96" size="40 40 8 0.5"/>

    <material name="pad_mat"       rgba="0.16 0.17 0.20 1" specular="0.3" shininess="0.4"/>
    <material name="pad_mark_mat"  rgba="0.94 0.94 0.94 1"/>
    <material name="drop_mat"      rgba="0.10 0.85 0.35 0.30"/>
    <material name="drop_ring_mat" rgba="0.05 0.78 0.30 0.95"/>
    <material name="clinic_mat"    rgba="0.90 0.90 0.87 1" specular="0.2"/>
    <material name="roof_mat"      rgba="0.55 0.24 0.18 1"/>
    <material name="body_mat"      rgba="0.93 0.94 0.96 1" specular="0.5" shininess="0.6"/>
    <material name="dark_mat"      rgba="0.13 0.14 0.17 1" specular="0.4" shininess="0.5"/>
    <material name="rotor_mat"     rgba="0.20 0.22 0.26 0.70"/>
    <material name="blood_mat"     rgba="0.76 0.08 0.12 1" specular="0.3"/>
    <material name="cool_mat"      rgba="0.93 0.95 0.98 1"/>
    <material name="pylon_mat"     rgba="0.95 0.60 0.10 0.30"/>
  </asset>

  <default>
    <geom contype="1" conaffinity="1" condim="3" friction="0.9 0.02 0.001"/>
    <default class="frame">
      <geom material="body_mat" density="300"/>
    </default>
    <!-- rotor discs are visual: their lift is applied through the thrust actuators -->
    <default class="rotor">
      <geom type="cylinder" material="rotor_mat" contype="0" conaffinity="0" mass="0.005"/>
    </default>
    <default class="scenery">
      <geom contype="1" conaffinity="1"/>
    </default>
    <default class="decor">
      <geom contype="0" conaffinity="0" mass="0"/>
    </default>
  </default>

  <worldbody>

    <light name="sun" pos="-10 -12 30" dir="0.25 0.35 -1" directional="true"
           diffuse="0.6 0.58 0.54" specular="0.12 0.12 0.12" castshadow="true"/>

    <!-- ============================= terrain ============================= -->
    <geom name="terrain" type="hfield" hfield="terrain" material="terrain_mat"
          pos="0 0 0" class="scenery" friction="1.2 0.05 0.002"/>

    <!-- ====================== distribution centre ======================== -->
    <body name="launch_site" pos="-30 0 0">
      <geom name="pad_base" type="cylinder" size="3.0 0.25" pos="0 0 0.25"
            material="pad_mat" class="scenery"/>
      <geom name="pad_ring" type="cylinder" size="2.5 0.02" pos="0 0 0.52"
            material="pad_mark_mat" class="decor"/>
      <geom name="pad_h_l" type="box" size="0.16 1.0 0.02" pos="-0.7 0 0.55"
            material="pad_mat" class="decor"/>
      <geom name="pad_h_r" type="box" size="0.16 1.0 0.02" pos="0.7 0 0.55"
            material="pad_mat" class="decor"/>
      <geom name="pad_h_c" type="box" size="0.7 0.16 0.02" pos="0 0 0.55"
            material="pad_mat" class="decor"/>
      <!-- offset to the side of the pad: sitting directly behind it put the
           chase camera inside the building on the first frame of every replay -->
      <geom name="depot" type="box" size="4.0 6.0 3.0" pos="-6 11 3"
            material="clinic_mat" class="scenery"/>
      <geom name="depot_roof" type="box" size="4.3 6.3 0.3" pos="-6 11 6.2"
            material="roof_mat" class="decor"/>
    </body>

    <!-- =========================== health post ===========================
         Mocap body, so python can move the whole delivery site each reset.  -->
    <body name="health_post" mocap="true" pos="30 0 0">
      <geom name="clinic" type="box" size="3.0 4.5 2.4" pos="-7.5 4.5 2.4"
            material="clinic_mat" class="scenery"/>
      <geom name="clinic_roof" type="box" size="3.3 4.8 0.28" pos="-7.5 4.5 5.05"
            material="roof_mat" class="decor"/>
      <geom name="drop_zone" type="cylinder" size="3.0 0.06" pos="0 0 0.06"
            material="drop_ring_mat" class="decor"/>
      <geom name="drop_column" type="cylinder" size="3.0 5.0" pos="0 0 5.0"
            material="drop_mat" class="decor"/>
      <site name="drop_target" pos="0 0 0.12" size="0.25" rgba="1 0.95 0.2 1"/>
    </body>

    <!-- ==================== flight corridor markers ======================
         Decorative pylons that make the regulated corridor visible on video. -->
    <body name="corridor_marks" pos="0 0 0">
      <geom name="pyl_a" type="cylinder" size="0.3 12" pos="-20 -20 12" material="pylon_mat" class="decor"/>
      <geom name="pyl_b" type="cylinder" size="0.3 12" pos="-20  20 12" material="pylon_mat" class="decor"/>
      <geom name="pyl_c" type="cylinder" size="0.3 12" pos="  0 -20 12" material="pylon_mat" class="decor"/>
      <geom name="pyl_d" type="cylinder" size="0.3 12" pos="  0  20 12" material="pylon_mat" class="decor"/>
      <geom name="pyl_e" type="cylinder" size="0.3 12" pos=" 20 -20 12" material="pylon_mat" class="decor"/>
      <geom name="pyl_f" type="cylinder" size="0.3 12" pos=" 20  20 12" material="pylon_mat" class="decor"/>
    </body>

    <!-- ============================== UAV ================================ -->
    <body name="drone" pos="-30 0 1.35">
      <freejoint name="drone_free"/>
      <inertial pos="0 0 0" mass="1.6" diaginertia="0.021 0.021 0.038"/>

      <camera name="chase" pos="-4.5 0 1.6" xyaxes="0 -1 0 0.30 0 0.95" mode="trackcom"/>
      <camera name="onboard" pos="0.28 0 -0.05" xyaxes="0 -1 0 0.35 0 -0.94"/>

      <geom name="fuselage" type="box" size="0.17 0.09 0.045" class="frame"/>
      <geom name="nose" type="ellipsoid" size="0.09 0.075 0.04" pos="0.19 0 0" class="frame"/>
      <geom name="tail_fin" type="box" size="0.08 0.012 0.06" pos="-0.2 0 0.06"
            material="dark_mat" class="decor"/>

      <!-- cold-chain cargo bay -->
      <geom name="cargo_bay" type="box" size="0.10 0.07 0.03" pos="0 0 -0.07"
            material="cool_mat" class="frame"/>

      <geom name="arm_1" type="capsule" fromto="0 0 0  0.20  0.20 0" size="0.014" class="frame"/>
      <geom name="arm_2" type="capsule" fromto="0 0 0 -0.20  0.20 0" size="0.014" class="frame"/>
      <geom name="arm_3" type="capsule" fromto="0 0 0 -0.20 -0.20 0" size="0.014" class="frame"/>
      <geom name="arm_4" type="capsule" fromto="0 0 0  0.20 -0.20 0" size="0.014" class="frame"/>

      <geom name="pod_1" type="cylinder" size="0.026 0.022" pos=" 0.20  0.20 0.018" material="dark_mat" class="frame"/>
      <geom name="pod_2" type="cylinder" size="0.026 0.022" pos="-0.20  0.20 0.018" material="dark_mat" class="frame"/>
      <geom name="pod_3" type="cylinder" size="0.026 0.022" pos="-0.20 -0.20 0.018" material="dark_mat" class="frame"/>
      <geom name="pod_4" type="cylinder" size="0.026 0.022" pos=" 0.20 -0.20 0.018" material="dark_mat" class="frame"/>

      <geom name="disc_1" size="0.105 0.004" pos=" 0.20  0.20 0.044" class="rotor"/>
      <geom name="disc_2" size="0.105 0.004" pos="-0.20  0.20 0.044" class="rotor"/>
      <geom name="disc_3" size="0.105 0.004" pos="-0.20 -0.20 0.044" class="rotor"/>
      <geom name="disc_4" size="0.105 0.004" pos=" 0.20 -0.20 0.044" class="rotor"/>

      <geom name="leg_fl" type="capsule" fromto=" 0.10  0.09 -0.05  0.10  0.13 -0.17" size="0.010" material="dark_mat" class="frame"/>
      <geom name="leg_fr" type="capsule" fromto=" 0.10 -0.09 -0.05  0.10 -0.13 -0.17" size="0.010" material="dark_mat" class="frame"/>
      <geom name="leg_bl" type="capsule" fromto="-0.12  0.09 -0.05 -0.12  0.13 -0.17" size="0.010" material="dark_mat" class="frame"/>
      <geom name="leg_br" type="capsule" fromto="-0.12 -0.09 -0.05 -0.12 -0.13 -0.17" size="0.010" material="dark_mat" class="frame"/>

      <!-- thrust application points, one per rotor -->
      <site name="rotor_1" pos=" 0.20  0.20 0.044" size="0.012" rgba="0.9 0.3 0.2 0"/>
      <site name="rotor_2" pos="-0.20  0.20 0.044" size="0.012" rgba="0.9 0.3 0.2 0"/>
      <site name="rotor_3" pos="-0.20 -0.20 0.044" size="0.012" rgba="0.9 0.3 0.2 0"/>
      <site name="rotor_4" pos=" 0.20 -0.20 0.044" size="0.012" rgba="0.9 0.3 0.2 0"/>
      <site name="imu" pos="0 0 0" size="0.01" rgba="0 0 0 0"/>
      <site name="hardpoint" pos="0 0 -0.115" size="0.012" rgba="0 0 0 0"/>
    </body>

    <!-- =========================== blood payload =========================
         Free body welded under the UAV; RELEASE_PAYLOAD kills the weld.     -->
    <body name="payload" pos="-30 0 1.195">
      <freejoint name="payload_free"/>
      <inertial pos="0 0 0" mass="0.30" diaginertia="0.0006 0.0006 0.0006"/>
      <geom name="payload_box" type="box" size="0.075 0.055 0.055"
            material="cool_mat" class="scenery" friction="0.8 0.02 0.001"/>
      <geom name="payload_cross_v" type="box" size="0.012 0.056 0.030"
            material="blood_mat" class="decor"/>
      <geom name="payload_cross_h" type="box" size="0.012 0.030 0.056"
            material="blood_mat" class="decor"/>
      <site name="payload_site" pos="0 0 0" size="0.01" rgba="0 0 0 0"/>
    </body>

  </worldbody>

  <!-- the welded payload must not also generate contacts against the airframe -->
  <contact>
    <exclude body1="drone" body2="payload"/>
  </contact>

  <!-- active at reset, deactivated by RELEASE_PAYLOAD -->
  <equality>
    <weld name="payload_weld" body1="drone" body2="payload"
          anchor="0 0 -0.115" relpose="0 0 -0.155 1 0 0 0" solref="0.004 1"/>
  </equality>

  <!--
    Rotor actuators. gear = (fx fy fz tx ty tz) expressed in each rotor site's
    frame: every rotor pushes along its local +z and produces a reaction yaw
    torque whose sign alternates around the airframe, exactly as on a real
    quadrotor. Roll, pitch and yaw therefore come from differential thrust.
    4 x 7.5 N = 30 N max against a 1.9 kg loaded weight -> T/W = 1.61.
  -->
  <actuator>
    <motor name="thrust_1" site="rotor_1" gear="0 0 1 0 0 -0.0136" ctrlrange="0 7.5"/>
    <motor name="thrust_2" site="rotor_2" gear="0 0 1 0 0  0.0136" ctrlrange="0 7.5"/>
    <motor name="thrust_3" site="rotor_3" gear="0 0 1 0 0 -0.0136" ctrlrange="0 7.5"/>
    <motor name="thrust_4" site="rotor_4" gear="0 0 1 0 0  0.0136" ctrlrange="0 7.5"/>
  </actuator>

  <sensor>
    <framepos      name="s_pos"     objtype="site" objname="imu"/>
    <framequat     name="s_quat"    objtype="site" objname="imu"/>
    <velocimeter   name="s_vel"     site="imu"/>
    <gyro          name="s_gyro"    site="imu"/>
    <accelerometer name="s_acc"     site="imu"/>
    <framepos      name="s_payload" objtype="site" objname="payload_site"/>
  </sensor>

</mujoco>
